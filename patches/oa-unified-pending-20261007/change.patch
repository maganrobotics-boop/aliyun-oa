+.oa-pending-banner-copy > small { display: block; margin-top: 5px; color: #61768b; font-size: 12px; line-height: 1.6; }
+.oa-pending-banner-action { display: flex; align-items: center; gap: 5px; flex-shrink: 0; font-size: 13px; font-weight: 650; }
+.oa-pending-banner-action svg { width: 17px; }
+.oa-global-pending:focus-visible,.oa-pending-banner:focus-visible { outline: 3px solid #729be1; outline-offset: 3px; }
+.oa-primary-navigation > button { position: relative; }
+.oa-primary-navigation .oa-nav-pending { position: absolute; top: 0; left: calc(50% + 7px); min-width: 19px; min-height: 19px; padding: 0 4px; background: #c34739; color: #fff; font-size: 10px; border: 2px solid #fff; }

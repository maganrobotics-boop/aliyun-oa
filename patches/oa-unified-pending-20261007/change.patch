+.oa-app .oa-global-pending { display: inline-flex; align-items: center; justify-content: center; gap: 7px; flex-shrink: 0; margin-left: auto; min-height: 42px; padding: 8px 12px; border: 1px solid #ccddec; border-radius: 10px; background: #f3f8fd; color: #215d96; font-size: 13px; font-weight: 650; white-space: nowrap; cursor: pointer; }

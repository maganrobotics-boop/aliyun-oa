+  .oa-app .oa-model-chat-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+  .oa-pending-banner { padding: 14px 12px; gap: 9px; margin-top: 12px; }
+  .oa-pending-banner-copy > strong { font-size: 16px; }
+  .oa-pending-banner > svg { display: none; }
+  .oa-pending-banner-action { font-size: 12px; }
+}
